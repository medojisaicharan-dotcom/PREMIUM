{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "dev",
      "path": "premium-login",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*(Local:\\s+http://localhost:5173/|ready in).*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "label": "npm: dev"
    }
  ]
}
